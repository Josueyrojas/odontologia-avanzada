# Copia este archivo como .env.local y llena tus llaves de Supabase (Project Settings › API).
# Sin este archivo la app funciona en modo local (datos en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "anon public" o "publishable" key. NUNCA pongas aquí la service_role / secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Contacto de soporte de Odonty (opcional): aparece cuando una licencia está pendiente, por vencer o suspendida.
# WhatsApp con 10 dígitos, sin espacios.
NEXT_PUBLIC_SOPORTE_WHATSAPP=
NEXT_PUBLIC_SOPORTE_EMAIL=
